  },
  "devDependencies": {
    "@julaika/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
