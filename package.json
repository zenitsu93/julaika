{
  "name": "julaika",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -F @julaika/client build && pnpm -F @julaika/server build",
    "start": "node apps/server/dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/client"
  },
  "devDependencies": {
    "@julaika/shared": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
